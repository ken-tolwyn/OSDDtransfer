UPSTREAM_DIR_MODE=2775

UPSTREAM_TRANSFER_ITEMS=(
  repository
  registry
  maven
)

MAVEN_ROOT=${TRUNK_ROOT}/maven
MAVEN_TRANSFER_NAME=maven
MAVEN_STORAGE_DIR=${MAVEN_ROOT}/reposilite

REPOSILITE_JAVA_BIN=java
REPOSILITE_JAR=${HOME}/bin/reposilite.jar
REPOSILITE_PORT=8081
REPOSILITE_CONFIGURATION_FILE=
REPOSILITE_JAVA_OPTS=()
REPOSILITE_EXTRA_ARGS=()

UPSTREAM_WATCH_EVENTS=close_write,create,delete,move,attrib

UPSTREAM_ZOT_BIN=${HOME}/bin/zot
UPSTREAM_ZOT_HOST=0.0.0.0
UPSTREAM_ZOT_PORT=${LOCAL_REGISTRY_PORT}
UPSTREAM_ZOT_DATA_DIR=${TRUNK_ROOT}/registry/data
UPSTREAM_ZOT_RUNTIME_CONFIG=${TRUNK_ROOT}/registry/zot-config.generated.json
UPSTREAM_ZOT_LOG_LEVEL=info
