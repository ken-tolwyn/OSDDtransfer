[Unit]
Description=Upstream Transfer Hard-Link Watcher
After=upstream-zot.service upstream-reposilite.service
Wants=upstream-zot.service upstream-reposilite.service

[Service]
Type=simple
WorkingDirectory=/path/to/this/repository
ExecStartPre=/usr/bin/bash /path/to/this/repository/upstream/setup-upstream.sh
ExecStartPre=/usr/bin/bash /path/to/this/repository/upstream/test-trunk-permissions.sh /trunk
ExecStart=/usr/bin/bash /path/to/this/repository/upstream/watch-transfer-links.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
