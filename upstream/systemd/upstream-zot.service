[Unit]
Description=Upstream Zot Registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/this/repository
ExecStartPre=/usr/bin/bash /path/to/this/repository/upstream/setup-upstream.sh
ExecStartPre=/usr/bin/bash /path/to/this/repository/upstream/test-trunk-permissions.sh /trunk
ExecStart=/usr/bin/bash /path/to/this/repository/upstream/start-zot.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
