REGISTRY_STORAGE_DIR=/trunk/registry
REGISTRY_TRANSFER_NAME=registry
REGISTRY_CONTAINER_NAME=zot-upstream
REGISTRY_LISTEN_PORT=5001
REGISTRY_IMAGE=ghcr.io/project-zot/zot-linux-amd64:latest
REGISTRY_CONFIG_FILE=$SCRIPT_DIR/zot_config.json
REGISTRY_IMAGE_LIST=$SCRIPT_DIR/outside.yaml
REGISTRY_CHART_LIST=$SCRIPT_DIR/charts.yaml
REGISTRY_CHART_NAMESPACE=public
HELM_CONTAINER_IMAGE=docker.io/alpine/helm:3.20.2
SYNC_HELM_CHARTS=true
SYNC_KUBEADM_IMAGES=true
KUBERNETES_VERSION=stable-1.29
REGISTRY_RECONCILE_EXCLUDE_PREFIXES=(
  charts/
)
REGISTRY_RECONCILE_EXCLUDE_REPOS=(
  trivy-db
  trivy-java-db
  grype-db
  oracle-oval
)

TRIVY_DB_SOURCE=ghcr.io/aquasecurity
TRIVY_IMAGES=(
  trivy-db:2
  trivy-java-db:1
)

GRYPE_DB_SOURCE=https://grype.anchore.io/databases/v6
GRYPE_TEMPLATE_URL=https://raw.githubusercontent.com/anchore/grype/refs/heads/main/templates/junit.tmpl
GRYPE_IMAGE_REF=grype-db:v6

REGISTRY_SCAN_TMP_DIR=$SCRIPT_DIR/tmp
REGISTRY_SCAN_CSV_TEMPLATE=$SCRIPT_DIR/scan/csv.tmpl
REGISTRY_SCAN_LATEX_TEMPLATE=$SCRIPT_DIR/scan/latex-table.tmpl

OL8_OVAL_URL=https://linux.oracle.com/security/oval/com.oracle.elsa-ol8.xml.bz2
OL8_OVAL_DB_FILE=com.oracle.elsa-ol8.xml.bz2
OL8_OVAL_IMAGE_REF=oracle-oval:ol8
