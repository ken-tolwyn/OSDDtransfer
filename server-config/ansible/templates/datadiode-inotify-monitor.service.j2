[Unit]
Description=Datadiode inotify monitor
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/datadiode-inotify-monitor.sh {{ datadiode_inotify_log_dir }}/inotify.log {% for p in datadiode_inotify_paths %}{{ p }} {% endfor %}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
