# Repository Synchronization Configuration
# This file contains configuration settings for the repository synchronization script

# Project location settings
# PROJECT_LOCATION: Relative path where repositories will be stored within the trunk
PROJECT_LOCATION=repository

# Repository URL settings
# REPOSITORY_BASEURL: Base URL where synchronized repositories will be accessible
# REPOSITORY_KEYS_BASEURL: Base URL for GPG keys used by repositories
REPOSITORY_BASEURL=https://repo.k.mis.local
REPOSITORY_KEYS_BASEURL=https://repo.k.mis.local/keys

# GPG Key Files
# List of GPG key files used to verify package signatures
# These keys are copied to the repository keys directory during synchronization
REPOSITORY_GPG_KEY_FILES=(
  /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
)

# NISP ISO Configuration
# NISP_ISO_GLOB: File glob pattern to find NISP ISO files for import
# NISP (NATO Interoperability Standards and Profiles) ISOs contain additional repositories
NISP_ISO_GLOB=/tmp/NU-NISP*.iso

# Oracle Linux 8 Repositories
# List of repository IDs to synchronize for Oracle Linux 8
OL8_REPOS=(
  ol8_baseos_latest
  ol8_appstream
  ol8_addons
  ol8_UEKR7
  hashicorp
  ol8_developer
  ol8_developer_EPEL
  ol8_codeready_builder
  ol8_kvm_appstream
  kubernetes
)

# Oracle Linux 9 Repositories
# List of repository IDs to synchronize for Oracle Linux 9
OL9_REPOS=(
  ol9_developer_EPEL
  ol9_appstream
  ol9_addons
  ol9_codeready_builder
  ol9_UEKR7
  ol9_UEKR8
  ol9_kvm_utils
)

# Grype Vulnerability Database
# URL for the Grype vulnerability database used for security scanning
GRYPE_DB_URL="https://grype.anchore.io/databases/v6"
