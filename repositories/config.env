REPOSITORY_ROOT=/trunk/repository
OL8_REPOSITORY_ROOT=/trunk/repository/OL8
OL9_REPOSITORY_ROOT=/trunk/repository/OL9
REPOSITORY_KEYS_DIR=/trunk/repository/keys
REPOSITORY_TRANSFER_NAME=repository

REPOSITORY_BASEURL=https://repo.k.mis.local
REPOSITORY_KEYS_BASEURL=https://repo.k.mis.local/keys
REPOSITORY_GPG_KEY_FILES=(
  /etc/pki/rpm-gpg/RPM-GPG-KEY-oracle
)

NISP_ISO_GLOB=/tmp/NISP*.iso

OL8_REPOS=(
  ol8_baseos_latest
  ol8_appstream
  ol8_addons
  ol8_UEKR7
  hashicorp
  ol8_developer
  ol8_developer_EPEL
  ol8_codeready_builder
  ol8_kvm_appstream
  kubernetes
)

OL9_REPOS=(
  ol9_developer_EPEL
  ol9_appstream
  ol9_addons
  ol9_codeready_builder
  ol9_UEKR7
  ol9_UEKR8
  ol9_kvm_utils
)

OL8_REPO_FILE_BASEURL=${REPOSITORY_BASEURL}/OL8
OL9_REPO_FILE_BASEURL=${REPOSITORY_BASEURL}/OL9

REPOSITORY_SYNC_IMAGE=sync_ol9
REPOSITORY_CONTAINERFILE=$SCRIPT_DIR/Containerfile
